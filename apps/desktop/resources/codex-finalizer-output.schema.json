{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "revision": { "type": "string", "pattern": "^revision_[a-f0-9]{32}$" },
    "seriesRevision": { "type": "string", "pattern": "^series_[a-f0-9]{32}$" },
    "scope": { "type": "string", "enum": ["thisEvent", "thisAndFollowing", "allEvents"] },
    "attendees": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 3, "maxLength": 320 } },
    "time": { "anyOf": [
      { "type": "object", "properties": { "kind": { "type": "string", "const": "timed" }, "startMs": { "type": "integer" }, "endMs": { "type": "integer" } }, "required": ["kind", "startMs", "endMs"], "additionalProperties": false },
      { "type": "object", "properties": { "kind": { "type": "string", "const": "allDay" }, "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }, "required": ["kind", "startDate", "endDate"], "additionalProperties": false }
    ] },
    "recurrenceEnd": { "anyOf": [
      { "type": "object", "properties": { "kind": { "type": "string", "const": "never" } }, "required": ["kind"], "additionalProperties": false },
      { "type": "object", "properties": { "kind": { "type": "string", "const": "onDate" }, "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }, "required": ["kind", "date"], "additionalProperties": false },
      { "type": "object", "properties": { "kind": { "type": "string", "const": "count" }, "count": { "type": "integer", "minimum": 1, "maximum": 10000 } }, "required": ["kind", "count"], "additionalProperties": false }
    ] },
    "recurrence": { "type": "object", "properties": { "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly"] }, "interval": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 100 }, { "type": "null" }] }, "weekdays": { "anyOf": [{ "type": "array", "minItems": 1, "maxItems": 7, "items": { "type": "string", "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] } }, { "type": "null" }] }, "end": { "anyOf": [{ "$ref": "#/$defs/recurrenceEnd" }, { "type": "null" }] }, "sourceLines": { "anyOf": [{ "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }, { "type": "null" }] } }, "required": ["frequency", "interval", "weekdays", "end", "sourceLines"], "additionalProperties": false },
    "recurrenceChange": { "anyOf": [{ "$ref": "#/$defs/recurrence" }, { "type": "object", "properties": { "kind": { "type": "string", "const": "remove" } }, "required": ["kind"], "additionalProperties": false }, { "type": "null" }] },
    "changes": { "type": "object", "properties": { "summary": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 500 }, { "type": "null" }] }, "time": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }, "description": { "anyOf": [{ "type": "string", "maxLength": 4000 }, { "type": "null" }] }, "location": { "anyOf": [{ "type": "string", "maxLength": 1000 }, { "type": "null" }] }, "attendees": { "anyOf": [{ "$ref": "#/$defs/attendees" }, { "type": "null" }] }, "recurrence": { "$ref": "#/$defs/recurrenceChange" } }, "required": ["summary", "time", "description", "location", "attendees", "recurrence"], "additionalProperties": false }
  },
  "type": "object",
  "properties": {
    "markdown": { "type": "string", "maxLength": 8000 },
    "proposals": { "type": "array", "maxItems": 8, "items": { "anyOf": [
      { "type": "object", "properties": { "kind": { "type": "string", "const": "create" }, "calendarId": { "$ref": "#/$defs/id" }, "summary": { "type": "string", "minLength": 1, "maxLength": 500 }, "time": { "$ref": "#/$defs/time" }, "description": { "anyOf": [{ "type": "string", "maxLength": 4000 }, { "type": "null" }] }, "location": { "anyOf": [{ "type": "string", "maxLength": 1000 }, { "type": "null" }] }, "attendees": { "anyOf": [{ "$ref": "#/$defs/attendees" }, { "type": "null" }] }, "recurrence": { "anyOf": [{ "$ref": "#/$defs/recurrence" }, { "type": "null" }] } }, "required": ["kind", "calendarId", "summary", "time", "description", "location", "attendees", "recurrence"], "additionalProperties": false },
      { "type": "object", "properties": { "kind": { "type": "string", "const": "update" }, "calendarId": { "$ref": "#/$defs/id" }, "eventId": { "$ref": "#/$defs/id" }, "expectedUpdatedAt": { "type": "number", "minimum": 0 }, "expectedRevision": { "$ref": "#/$defs/revision" }, "expectedSeriesRevision": { "anyOf": [{ "$ref": "#/$defs/seriesRevision" }, { "type": "null" }] }, "changes": { "$ref": "#/$defs/changes" }, "scope": { "anyOf": [{ "$ref": "#/$defs/scope" }, { "type": "null" }] } }, "required": ["kind", "calendarId", "eventId", "expectedUpdatedAt", "expectedRevision", "expectedSeriesRevision", "changes", "scope"], "additionalProperties": false },
      { "type": "object", "properties": { "kind": { "type": "string", "const": "delete" }, "calendarId": { "$ref": "#/$defs/id" }, "eventId": { "$ref": "#/$defs/id" }, "expectedUpdatedAt": { "type": "number", "minimum": 0 }, "expectedRevision": { "$ref": "#/$defs/revision" }, "expectedSeriesRevision": { "anyOf": [{ "$ref": "#/$defs/seriesRevision" }, { "type": "null" }] }, "scope": { "$ref": "#/$defs/scope" } }, "required": ["kind", "calendarId", "eventId", "expectedUpdatedAt", "expectedRevision", "expectedSeriesRevision", "scope"], "additionalProperties": false }
    ] } }
  },
  "required": ["markdown", "proposals"],
  "additionalProperties": false
}
